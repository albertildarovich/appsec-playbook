# Copy to .env and fill in your values.
# The .env file is gitignored — never commit secrets.

# --- LLM providers ---
# Choose one: openai | anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# --- Database (pgvector) ---
# DATABASE_URL=postgresql+psycopg://ai_security:ai_security_dev@localhost:5432/ai_security

# --- Jira integration ---
# JIRA_URL=https://your-jira.example.com
# JIRA_TOKEN=...

# --- MCP server ---
# MCP_AUTH_TOKEN=...

# --- Agent limits ---
AGENT_MAX_TURNS=10
